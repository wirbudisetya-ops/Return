rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net - default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'wirbudisetya@gmail.com'
      );
    }

    function isAuthorizedUser() {
      return isSignedIn() && (
        isSuperAdmin() ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
      );
    }

    // Connectivity test collection
    match /test/{docId} {
      allow read, write: if isSignedIn();
    }

    // Users and Authorization Directory
    match /users/{userId} {
      // Any authenticated user can read profiles to determine role/DC permissions
      allow read: if isSignedIn();
      // Super admin can manage all authorizations; user can bootstrap own profile
      allow create, update: if isSignedIn() && (
        isSuperAdmin() || 
        request.auth.uid == userId
      );
      allow delete: if isSuperAdmin();
    }

    // Cosmetic Returns Collection
    match /returns/{returnId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSuperAdmin();
    }

    // Transfers Collection
    match /transfers/{transferId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSuperAdmin();
    }
  }
}
